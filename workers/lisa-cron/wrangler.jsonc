{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lisa-cron",
  "main": "src/index.js",

  // Trava o comportamento da plataforma numa data. Sem isso, uma mudança futura da Cloudflare
  // poderia alterar o runtime debaixo de um deploy que já funcionava.
  "compatibility_date": "2026-09-13",

  // É esta linha que faz o web-push funcionar aqui — e foi justamente ela que não bastou
  // enquanto as rotas rodavam em Edge runtime, que não tem http/https/net.
  "compatibility_flags": ["nodejs_compat"],

  "triggers": {
    "crons": [
      "*/5 * * * *",   // notificações e falas agendadas + avanço do ciclo de sync
      "*/15 * * * *",  // Map of Deploy
      "0 * * * *"      // reinício do ciclo de sync
    ]
  },

  // TROQUE pelo endereço final da Lisa. Recém-publicada ela atende em
  // https://beyond-assist.<seu-subdominio>.workers.dev; depois, no domínio próprio.
  // Os horários dos crons acima são em UTC.
  "vars": { "LISA_URL": "https://beyond-assist.workers.dev" },

  "observability": { "enabled": true }
}
