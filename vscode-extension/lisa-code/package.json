{
  "name": "lisa-code",
  "displayName": "Lisa Code",
  "description": "A Lisa (Beyond Bits) dentro do VS Code — conversa, lê e propõe mudanças no seu código. Extensão de uso PESSOAL, nunca publicada.",
  "version": "0.0.6",
  "publisher": "personal-use-only",
  "private": true,
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other"],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        { "id": "lisaCode", "title": "Lisa Code", "icon": "resources/icon.svg" }
      ]
    },
    "views": {
      "lisaCode": [
        { "id": "lisaCode.chatView", "name": "Lisa Code", "type": "webview" }
      ]
    },
    "commands": [
      { "command": "lisaCode.setToken", "title": "Lisa Code: Configurar token pessoal" },
      { "command": "lisaCode.setBaseUrl", "title": "Lisa Code: Configurar URL do Beyond Bits" },
      { "command": "lisaCode.newConversation", "title": "Lisa Code: Nova conversa" },
      { "command": "lisaCode.openFloating", "title": "Lisa Code: Abrir janela flutuante" }
    ],
    "configuration": {
      "title": "Lisa Code",
      "properties": {
        "lisaCode.baseUrl": {
          "type": "string",
          "default": "",
          "description": "URL base do Beyond Bits (ex.: https://seu-deploy.vercel.app) — sem barra no final."
        }
      }
    },
    "themes": [
      { "label": "Lisa HUD — Ciano", "uiTheme": "vs-dark", "path": "./themes/lisa-hud-ciano.json" },
      { "label": "Lisa HUD — Azul", "uiTheme": "vs-dark", "path": "./themes/lisa-hud-azul.json" },
      { "label": "Lisa HUD — Roxo", "uiTheme": "vs-dark", "path": "./themes/lisa-hud-roxo.json" },
      { "label": "Lisa HUD — Rosa", "uiTheme": "vs-dark", "path": "./themes/lisa-hud-rosa.json" },
      { "label": "Lisa HUD — Vermelho", "uiTheme": "vs-dark", "path": "./themes/lisa-hud-vermelho.json" },
      { "label": "Lisa HUD — Dourado", "uiTheme": "vs-dark", "path": "./themes/lisa-hud-dourado.json" }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "generate-themes": "node scripts/generate-themes.mjs",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0",
    "@vscode/vsce": "^2.24.0"
  }
}
