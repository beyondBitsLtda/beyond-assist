# Copie para .env.local e preencha. NUNCA versione o .env.local.
# Os valores do banco e da IA são os MESMOS do Abacato; a sessão tem segredo próprio.

# Banco (o Postgres do iMac, pelo túnel)
SUPABASE_URL=https://banco.beyond.dev.br
SUPABASE_SERVICE_ROLE_KEY=

# Sessão da Lisa_Proof — sorteie um valor novo (ex.: openssl rand -base64 48).
# Não reaproveite o ABACATO_SESSAO_SECRET: cada app assina os próprios cookies.
PROOF_SESSAO_SECRET=

# IA (as mesmas chaves do Abacato servem; separe por vírgula)
GEMINI_API_KEYS=
# GEMINI_CHAT_MODEL=gemini-3.6-flash

# Para os links "Abrir no Abacato"
ABACATO_URL=https://abacato.beyond.dev.br

# Opcional: só aumenta o limite de leitura de repositórios PÚBLICOS do GitHub
# GITHUB_TOKEN=

# Lembretes push — a chave PÚBLICA fica aqui. A PRIVADA vai em .env.lembretes
# (VAPID_PRIVATE_KEY=...), arquivo que só o script de lembretes lê.
# Gerar o par: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=https://proof.beyond.dev.br
