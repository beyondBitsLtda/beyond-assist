{
  "name": "lisa-proof",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "//": "Mesmas versoes do Abacato e da Lisa de proposito: o que ja foi provado no workerd deles nao precisa ser descoberto de novo aqui.",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "dominio-check": "node scripts/dominio-check.mjs",
    "migrar": "node --env-file=.env.local scripts/migrar.mjs",
    "cf:build": "opennextjs-cloudflare build",
    "cf:deploy": "opennextjs-cloudflare deploy",
    "publicar": "npm run cf:build && wrangler deploy",
    "lembretes": "node --env-file=.env.local --env-file=.env.lembretes scripts/lembretes.mjs"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@supabase/supabase-js": "^2.45.0",
    "next": "^15.5.25",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "wrangler": "^4.131.1"
  },
  "allowScripts": {
    "esbuild@0.25.4": true,
    "esbuild@0.28.1": true,
    "workerd@1.20261001.1": true
  },
  "devDependencies": {
    "web-push": "^3.6.7"
  }
}
